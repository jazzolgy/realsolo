{
  "schema_version": "1.0",
  "required": [
    "observation_id",
    "track_id",
    "source_id",
    "start_s",
    "end_s",
    "role",
    "confidence",
    "provenance"
  ],
  "fields": {
    "observation_id": "stable research id",
    "track_id": "verified source track id",
    "source_id": "source manifest id",
    "start_s": "track-relative start seconds",
    "end_s": "track-relative end seconds",
    "chorus": "optional chorus label",
    "form_section": "optional A/B/C/etc",
    "score_bar": "optional score/bar locator; never inferred when unknown",
    "role": [
      "time_carrier",
      "counterline",
      "foreground_solo",
      "response",
      "transition",
      "space",
      "other"
    ],
    "shared_solo_operations": [
      "state",
      "repeat",
      "vary",
      "fragment",
      "extend",
      "contract",
      "invert",
      "sequence",
      "displace",
      "augment",
      "diminish",
      "reorchestrate",
      "change_register",
      "add_space",
      "internal_rest",
      "contrast",
      "recap",
      "resolve",
      "target_next_harmony",
      "answer"
    ],
    "interval_schema": "relative abstract intervals only when confidently transcribed",
    "rhythm_schema": "relative beat durations/onset pattern",
    "contour": "abstract contour",
    "register_trajectory": "low/mid/high trajectory and excursion",
    "accent_shape": "abstract relative accents",
    "articulation": "abstract note-body/touch description",
    "harmonic_target_behavior": "local harmony vs delayed/next-harmony target",
    "tension_shape": "abstract tension/release trajectory",
    "interaction_function": "relation to piano/drums",
    "motif_relation": "new/recalled/varied/fragmented/sequenced/etc",
    "source_separation_status": "mixed_audio|bass_stem|manual_verified",
    "confidence": "0..1",
    "recurrence_group": "id for repeated evidence across independent windows",
    "promotion_status": "observation_only|vocabulary_candidate|tendency_candidate|promoted",
    "provenance": "source/personnel/analysis provenance"
  }
}